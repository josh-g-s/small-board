(rule "foreign_track_under_U48" (layer B.Cu) (condition "A.Type == 'Track' && A.intersectsBackCourtyard('U48') && A.NetName != '+3.3V' && A.NetName != 'GND' && A.NetName != 'IO6' && A.NetName != 'Net-(U42-Out)' && A.NetName != 'wir1'") (constraint disallow track))
(rule "foreign_track_under_U61" (layer B.Cu) (condition "A.Type == 'Track' && A.intersectsBackCourtyard('U61') && A.NetName != '+3.3V' && A.NetName != 'GND' && A.NetName != 'Net-(U60-Pad4)' && A.NetName != 'Net-(U62-B)'") (constraint disallow track))
(rule "foreign_track_under_U51" (layer B.Cu) (condition "A.Type == 'Track' && A.intersectsBackCourtyard('U51') && A.NetName != '+3.3V' && A.NetName != 'GND' && A.NetName != 'Net-(U27-B)' && A.NetName != 'Net-(U51-A)' && A.NetName != 'Net-(U51-B)'") (constraint disallow track))
# Unmodified library USB-C footprint J3 places pad B12 0.185 mm from its own NPTH peg; relax hole clearance only between J3's own items (all else stays 0.25 mm).
(rule "J3_library_own_hole_clearance" (constraint hole_clearance (min 0.15mm)) (condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3')"))
